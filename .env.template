# Environment Variables Template for Cloud Deployment
# Copy this file and set appropriate values for your environment

# Server Configuration
SERVER_PORT=8080

# Database Configuration (retrieve from AWS Secrets Manager in production)
DATABASE_URL=jdbc:postgresql://your-rds-endpoint:5432/resortdb
DATABASE_USERNAME=resort_app_user
DATABASE_PASSWORD=<retrieve-from-secrets-manager>

# Redis Configuration (Amazon ElastiCache endpoint)
REDIS_HOST=your-elasticache-endpoint.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=<retrieve-from-secrets-manager>
REDIS_TIMEOUT=2000
REDIS_CACHE_TTL_MINUTES=30

# Session Configuration
SESSION_TIMEOUT=1800

# AWS Configuration
AWS_REGION=us-east-1
AWS_S3_REPORTS_BUCKET=resort-reports-bucket-prod
AWS_SECRET_DATABASE_NAME=resort-db-credentials

# External Service Endpoints
PAYMENT_SERVICE_ENDPOINT=http://payment-service.internal:9090/payments/charge
INVENTORY_SERVICE_ENDPOINT=http://inventory-service.internal:8081/rooms/available
NOTIFICATION_SERVICE_ENDPOINT=http://notification-service.internal:7070/send

# Logging Configuration
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# H2 Console (disable in production)
H2_CONSOLE_ENABLED=false
